# Variables de entorno (§6.4). Sin valores secretos: LLM_API_KEY, HMAC_SECRET y PRIVACY_CONTACT_EMAIL
# se configuran en la plataforma de publicación, nunca en el repositorio.
APP_ENV=dev
PORT=8000
DATABASE_URL=sqlite:///./brujula_dev.db
LLM_MODE=demo
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
LLM_THINKING=between_tools
LLM_EFFORT=medium
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8000
SESSION_TTL_HOURS=24
PROFILE_VALIDITY_MONTHS=12
RATE_LIMIT_SESSION_PER_MIN=10
RATE_LIMIT_SESSION_TOTAL=50
RATE_LIMIT_IP_PER_MIN=60
HMAC_SECRET=
PRIVACY_CONTACT_EMAIL=
APP_VERSION=0.1.0
GIT_SHA=
LLM_BUDGET_DAILY_USD=1
LLM_BUDGET_MONTHLY_USD=10
LLM_BUDGET_EVAL_USD=5
LLM_PRICE_INPUT_USD_PER_MTOK=2
LLM_PRICE_OUTPUT_USD_PER_MTOK=10
LLM_KILL_SWITCH=false
HISTORICO_ENABLED=true
